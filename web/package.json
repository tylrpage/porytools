{
  "name": "porytools-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run wasm && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write . ../data/*.json",
    "format:check": "prettier --check . ../data/*.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cards": "node scripts/cards/build-cards.ts",
    "fetch-decklists": "node scripts/decklists/fetch-decklists.ts",
    "wasm": "node scripts/wasm/build-wasm.ts",
    "wasm:dev": "node scripts/wasm/build-wasm.ts --dev"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
